# Current React/FastAPI app. Server only: never put keys in VITE_ variables.
EXECUTION_MODE=live
DATABASE_PATH=data/lab.sqlite3
DEMO_DATABASE_PATH=data/demo.sqlite3
FREE_ONLY=true
REQUEST_TIMEOUT_SECONDS=60
